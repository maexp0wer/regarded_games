# ============================================================
# Ponder indexer — runtime environment contract
# ============================================================
#
# This file documents every environment variable the indexer reads. Copy it to
# `.env.local` and fill in real values there (`.env.local` is git-ignored — never
# commit secrets). See the root `.env.example` for the frontend's variables.
#
# Local dev note: in dual-fork mode, `start.bat` injects the Ponder/DB vars below
# (DATABASE_URL, PONDER_RPC_URL, PONDER_CHAIN_ID, PONDER_DEPLOYMENT,
# PONDER_START_BLOCK) per-process, so locally you rarely set them here. This file
# primarily captures the PRODUCTION contract: when the indexer runs standalone
# (e.g. a deployed container), every var below must be supplied via the env.
#
# Each network runs its own indexer instance. The same code/image serves both,
# differing only by the values below — run one instance per chain.


# --- Which deployment to index ------------------------------------------------
# mainnet | sepolia — selects which src/deployments/<...>/core.json is loaded
# for contract addresses. Default: mainnet.
PONDER_DEPLOYMENT=mainnet

# --- Chain --------------------------------------------------------------------
# Prod: 8453 (Base mainnet) / 84532 (Base Sepolia).
# Fork dev: 31337 (mainnet fork) / 31338 (sepolia fork). Default: 31337.
PONDER_CHAIN_ID=8453

# Chain RPC endpoint. In production use a real, paid Base RPC (e.g. Alchemy) with
# headroom — historical backfill hammers this endpoint.
PONDER_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY_HERE

# Optional fallback RPC, used only if PONDER_RPC_URL is unset (legacy local default
# for chain 31337). Leave blank in production.
PONDER_RPC_URL_31337=

# Block to begin indexing from. Set to the contracts' deployment block in prod
# (indexing from 0 wastes time/RPC on empty history). Default: 0.
PONDER_START_BLOCK=0

# --- Database -----------------------------------------------------------------
# Postgres connection string. Use a managed Postgres in production; never point
# this at a database that gets dropped/recreated (the local start.bat wipe-and-
# resync flow must not be used in prod). The indexer resumes from this DB on
# restart instead of re-backfilling.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# --- Callbacks into the Next.js app -------------------------------------------
# Base URL of the Next.js app the indexer calls for Discourse provisioning on
# indexed events (/api/discourse/{setup,init,sync}-*). Default: http://127.0.0.1:3000.
# In production set this to the deployed app's URL.
NEXT_PUBLIC_APP_URL=https://your-app-domain.example

# Shared secret sent as the `x-discourse-admin-token` header on those callbacks.
# MUST match DISCOURSE_INIT_SECRET in the root .env so the app authenticates the
# indexer. Generate a strong random value; keep it out of version control.
DISCOURSE_INIT_SECRET=replace-with-a-strong-random-secret
