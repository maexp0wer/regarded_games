# ============================================================
# Regarded Games — Environment Variables Reference
# ============================================================
# Copy this file to .env and fill in your values.
# Never commit .env or .env.local — they are gitignored.
# ============================================================

# ----- Chain -----------------------------------------------
# 31337 = local Anvil | 84532 = Base Sepolia | 8453 = Base mainnet
NEXT_PUBLIC_CHAIN_ID=31337

# ----- Database --------------------------------------------
POSTGRES_URL="postgresql://profile_manager:YOUR_PASSWORD@localhost:5432/ritardo_games"
PONDER_DATABASE_URL="postgresql://ponder_user:YOUR_PASSWORD@localhost:5432/ponder_main"

# ----- App URLs --------------------------------------------
NEXT_PUBLIC_MAIN_DOMAIN="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://127.0.0.1:3000"
NEXT_PUBLIC_ENVIRONMENT=local

# ----- RPC / Alchemy ---------------------------------------
NEXT_PUBLIC_ALCHEMY_API_KEY=your_alchemy_api_key_here
NEXT_PUBLIC_ALCHEMY_BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/${NEXT_PUBLIC_ALCHEMY_API_KEY}
NEXT_PUBLIC_ALCHEMY_BASE_SEPOLIA_RPC_URL=https://base-sepolia.g.alchemy.com/v2/${NEXT_PUBLIC_ALCHEMY_API_KEY}
NEXT_PUBLIC_ANVIL_RPC_URL=http://127.0.0.1:8545

# ----- WalletConnect ---------------------------------------
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# ----- Discourse -------------------------------------------
# Put actual keys in .env.local (never commit them)
NEXT_PUBLIC_DISCOURSE_URL=http://community.localhost
DISCOURSE_API_KEY=your_discourse_api_key_here
DISCOURSE_SSO_SECRET=your_discourse_sso_secret_here
DISCOURSE_API_USERNAME=system

# ----- Admin -----------------------------------------------
# Used to protect the /api/discourse/init-season endpoint
DISCOURSE_INIT_SECRET=your_strong_random_secret_here

# ----- Contracts -------------------------------------------
CONTROLLER_ADDRESS=0x0000000000000000000000000000000000000000
