# ============================================================
# Regarded Games — Environment Variables Reference
# ============================================================
# Copy this file to .env and fill in your values.
# Never commit .env or .env.local — they are gitignored.
# ============================================================

# ----- Debug -----------------------------------------------
# Set to true to enable verbose console.log output from API routes.
# DEBUG=true

# ----- Environment -----------------------------------------
# Two modes:
#   fork     → start.bat launches TWO Anvils + TWO Ponders side-by-side.
#              app.localhost          → mainnet fork (chain 31337, anvil :8545, ponder :42069)
#              app.sepolia.localhost  → sepolia fork (chain 31338, anvil :8546, ponder :42070)
#   mainnet  → no local Anvil/Ponder. Both subdomains hit real chains
#              (Base 8453 / Base Sepolia 84532) and hosted Ponder endpoints.
NEXT_PUBLIC_ENVIRONMENT=fork

# ----- Database --------------------------------------------
POSTGRES_URL="postgresql://profile_manager:YOUR_PASSWORD@localhost:5432/regarded_games"

# ----- App URLs --------------------------------------------
# Full URL of the root domain, WITH protocol (no trailing slash). Most call sites
# need the scheme (DOCS_URL is derived as <scheme>://docs.<host>, auth redirects,
# nav links). middleware.ts strips the scheme itself to match the bare Host header,
# so the port in localhost:3000 is preserved for local dev.
#   local: http://localhost:3000
#   prod:  https://yourdomain.com   (e.g. https://regarded.games)
NEXT_PUBLIC_MAIN_DOMAIN="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://127.0.0.1:3000"

# ----- Soft-launch gate ------------------------------------
# The app is LIVE by default — leave these unset for normal operation. Set a flag
# to the literal "false" only to GATE that surface before launch: middleware.ts
# then rewrites every matching request to /coming-soon, so the trading app is
# unreachable. The two subdomains gate independently, so testnet can stay open
# while mainnet is gated (or vice versa).
# Server-only flags (NO NEXT_PUBLIC_ prefix) are the real gate:
#   APP_LIVE=false          → gate the mainnet app  (app.*)
#   TESTNET_APP_LIVE=false  → gate the testnet app  (app.sepolia.*)
# NOTE (Vercel): env vars bind at build/deploy time — changing these requires a
# redeploy. For real safety, ALSO don't point the app.* DNS/subdomain at the host
# until launch; this flag is defence-in-depth behind that.
# APP_LIVE=false
# TESTNET_APP_LIVE=false
#
# These two flags are ALSO what the landing page reads: src/app/main/page.tsx is
# a server component that resolves them via src/config/stage.ts and passes the
# result to the client deck. That drives the hero's stage banner and decides,
# per card, whether a footer link opens the app or a "coming soon" modal. There
# is deliberately no NEXT_PUBLIC_ mirror to keep in sync.

# ----- Treasury holdings (optional, public /treasury page) --
# Addresses the treasury page reads balanceOf() against, beyond USDC and RGD
# (which come from the deployment files). Both are optional: unset means the
# asset is simply omitted from the holdings table, which is correct before the
# contracts exist. See src/config/treasuryHoldings.ts for why these are config
# rather than discovered on-chain.
#   aUSDC receipt token for the Treasury's Aave position:
# NEXT_PUBLIC_ATOKEN_USDC_ADDRESS=0x...
#   UniswapV2 RGD/USDC pair — also the price source for RGD and the LP position:
# NEXT_PUBLIC_RGD_USDC_PAIR_ADDRESS=0x...

# ----- RPC / Alchemy ---------------------------------------
# Alchemy API key (server-side only, not exposed to client).
# Used by /api/rpc/* endpoints to add the key when proxying mainnet RPC calls.
ALCHEMY_API_KEY=your_alchemy_api_key_here

# Per-fork Anvil RPC URLs (consumed by wagmi + tenants.ts in fork mode).
NEXT_PUBLIC_ANVIL_RPC_URL_MAINNET=http://127.0.0.1:8545
NEXT_PUBLIC_ANVIL_RPC_URL_SEPOLIA=http://127.0.0.1:8546

# ----- Ponder (per-tenant, mainnet mode only) --------------
# In fork mode the frontend automatically points at
# http://127.0.0.1:42069/graphql (mainnet) and :42070/graphql (sepolia).
NEXT_PUBLIC_PONDER_URL_MAINNET=https://ponder-mainnet.example.com/graphql
NEXT_PUBLIC_PONDER_URL_SEPOLIA=https://ponder-sepolia.example.com/graphql

# Quest DB connection for the INDEXER (server-side only, not NEXT_PUBLIC). The
# Ponder handlers write on-chain quest completions (faucet/swap/stake/auction/
# trade/claim/win) directly to the app's quest DB the moment the event is
# indexed, so quests conclude without the user ever opening the board. Point this
# at the same `regarded_games` DB as POSTGRES_URL. In fork mode start.bat sets it
# automatically (PG_APP_URL). If unset, event-driven crediting is disabled and
# quests fall back to the signed-in-GET write path.
QUEST_DATABASE_URL="postgresql://profile_manager:YOUR_PASSWORD@localhost:5432/regarded_games"

# ----- WalletConnect ---------------------------------------
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# ----- Discourse -------------------------------------------
# Put actual keys in .env.local (never commit them)
NEXT_PUBLIC_DISCOURSE_URL=http://community.localhost
DISCOURSE_API_KEY=your_discourse_api_key_here
DISCOURSE_SSO_SECRET=your_discourse_sso_secret_here
DISCOURSE_API_USERNAME=system

# ----- Community session -----------------------------------
# Secret used to HMAC-sign the verified community session cookie (chat/forum
# sign-in). Generate a long random value, e.g. `openssl rand -hex 32`.
COMMUNITY_SESSION_SECRET=your_long_random_session_secret_here

# ----- Faction-sync cache (src/lib/serverCache.ts) ---------
# Threshold cache TTL in ms (default 30000). Lower = fresher faction boundary,
# but recomputes the expensive Ponder median more often.
# FACTION_THRESHOLD_TTL_MS=30000
#
# Min % of on-chain FIM supply the indexed distribution must cover before the
# computed faction threshold is trusted (default 90). If the Ponder index is lagging
# and coverage drops below this, sync-faction skips reassignment for that cycle.
# FACTION_MIN_SUPPLY_COVERAGE_PCT=90
#
# The faction/group caches are in-memory per process today (fine for a single
# instance). For a serverless / multi-replica deploy, implement the documented
# Redis driver in serverCache.ts and set ONE of the following:
# REDIS_URL=redis://localhost:6379                 # self-hosted, via ioredis
# UPSTASH_REDIS_REST_URL=...                        # Upstash, via @upstash/redis
# UPSTASH_REDIS_REST_TOKEN=...

# ----- Admin -----------------------------------------------
# Used to protect the /api/discourse/init-season endpoint
DISCOURSE_INIT_SECRET=your_strong_random_secret_here
# Wallet address that receives Discourse admin/moderator role via SSO.
# Defaults to no admin if unset. Use a production wallet, NOT a Foundry test address.
ADMIN_WALLET=0xYourAdminWalletAddressHere

# ----- Anti-bot / CAPTCHA (Cloudflare Turnstile) -----------
# Register a site at dash.cloudflare.com → Turnstile.
# Leave TURNSTILE_SECRET_KEY unset in local dev to skip verification (auto-pass).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key_here
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here
